DRY_RUN=true
MAX_NOTIONAL_USD=250
ALLOW_SHORT_SELLING=false
FORCE_REPROCESS=false

OPTIONOMICS_API_KEY=your-optionomics-api-key
OPTIONOMICS_EMAIL=you@example.com
OPTIONOMICS_API_URL=https://optionomics.ai/api/v1/trade_ideas
OPTIONOMICS_POLL_ENABLED=true
OPTIONOMICS_POLL_INTERVAL_SECONDS=600

WEBULL_APP_KEY=your-webull-app-key
WEBULL_APP_SECRET=your-webull-app-secret
WEBULL_ENDPOINT=api.sandbox.webull.com

DATABASE_PATH=bot.sqlite3

# Strategy exit percentages (10 means 10%)
BULLISH_PROFIT_PERCENT=10
BULLISH_STOP_LOSS_PERCENT=5
BEARISH_PROFIT_PERCENT=20
BEARISH_STOP_LOSS_PERCENT=10
IRON_CONDOR_PROFIT_PERCENT=10
IRON_CONDOR_STOP_LOSS_PERCENT=5

# Required exact account number for bearish PUT and iron-condor submissions
OPTIONS_MARGIN_ACCOUNT_NUMBER=

# Exact cash account number for the main.py bullish stock path
BULLISH_STOCK_ACCOUNT_NUMBER=

# PUT quote age limit; 1200 allows 15-minute-delayed quotes for sandbox testing.
BEARISH_QUOTE_MAX_AGE_SECONDS=60

# Iron-condor quote age limit; use 1200 for delayed sandbox paper testing.
IRON_CONDOR_QUOTE_MAX_AGE_SECONDS=60

# Bearer token for the iOS trading API (Authorization: Bearer <token>).
# Leave empty to disable /api/trading/* (routes return 503).
IOS_API_KEY=
